# Secretos y ajustes propios de cada instancia.
.env

# El mismo fichero sin el punto, tal y como llega al copiarlo de otra maquina.
# Sin esta regla no esta ignorado, y un `git add -A` lo commitea con las
# contrasenas dentro. El historial de git es permanente: quitarlo despues del
# ultimo commit no lo saca del historial.
/env

# Y cualquier copia del .env. Antes de tocarlo con sed lo natural es hacer
# `cp .env .env.bak`, y esa copia lleva las mismas contrasenas pero NO la
# ignoraba ninguna regla: aparecia como fichero sin seguimiento, a un
# `git add -A` de distancia del historial permanente. Paso el 16/08/2026.
.env.*
env.*

# ...pero .env.example SI se versiona: es la plantilla que necesita la maquina
# destino. La excepcion es obligatoria, no cosmetica: `.env.*` lo captura.
# Hoy no se nota porque ya esta trackeado —y gitignore no afecta a lo ya
# trackeado, ni `git check-ignore` lo delata sin `--no-index`— pero en un clon
# nuevo desapareceria en silencio.
!.env.example

# Los backups son datos, no codigo. Se migran a mano, no por git.
backups/*
!backups/.gitkeep

# Ruido del sistema
Thumbs.db
desktop.ini
.DS_Store

# Artefacto de diagnostico, solo aparece si el juego cambia ajustes por su cuenta.
config/reference/server.ini.runtime

# Banco de trabajo: contiene assets de terceros pendientes de permiso.
# NO se versiona.
workbench/
