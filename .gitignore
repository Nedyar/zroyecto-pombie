# Secretos y ajustes propios de cada instancia.
.env

# El mismo fichero sin el punto, tal y como llega al copiarlo de otra maquina.
# Sin esta regla no esta ignorado, y un `git add -A` lo commitea con las
# contrasenas dentro. El historial de git es permanente: quitarlo despues del
# ultimo commit no lo saca del historial.
/env

# Los backups son datos, no codigo. Se migran a mano, no por git.
backups/*
!backups/.gitkeep

# Ruido del sistema
Thumbs.db
desktop.ini
.DS_Store

# Artefacto de diagnostico, solo aparece si el juego cambia ajustes por su cuenta.
config/reference/server.ini.runtime

# Banco de trabajo: contiene assets de terceros pendientes de permiso.
# NO se versiona.
workbench/
