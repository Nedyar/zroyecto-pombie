# ============================================================================
# Zroyecto Pombie - variables de la instancia
# ============================================================================
#
# Copia este fichero a `.env` y rellena las contrasenas.
#   cp .env.example .env
#
# `.env` esta en .gitignore: NO se versiona, porque lleva secretos.
# Este `.env.example` si, para que la maquina destino sepa que hace falta.
# ============================================================================

# --- Identidad -------------------------------------------------------------
# Da nombre a los ficheros de configuracion y a la carpeta de guardado.
# Solo letras, numeros, guion y guion bajo. Cambiarlo mas adelante equivale a
# empezar un mundo nuevo, asi que eligelo ahora.
PZ_SERVER_NAME=pombie

PZ_PUBLIC_NAME=Zroyecto Pombie
PZ_PUBLIC_DESCRIPTION=Servidor privado de Project Zomboid

# false = no aparece en la lista publica de servidores. Se entra por IP.
PZ_PUBLIC=false

# Servidor abierto (sin whitelist previa: las cuentas se crean al entrar).
# Combinado con PZ_SERVER_PASSWORD es lo razonable para un grupo de amigos.
PZ_OPEN=true

# --- Credenciales ----------------------------------------------------------
# OBLIGATORIAS. El contenedor se niega a arrancar si siguen en CAMBIAME.
PZ_ADMIN_USERNAME=admin
PZ_ADMIN_PASSWORD=CAMBIAME

# Contrasena para entrar al servidor. Vacio = sin contrasena.
PZ_SERVER_PASSWORD=CAMBIAME

# RCON es lo que permite el apagado seguro (save + quit antes de parar).
# No es opcional: sin ella no hay garantia de guardado limpio.
PZ_RCON_PASSWORD=CAMBIAME

# --- Partida ---------------------------------------------------------------
PZ_MAX_PLAYERS=8
PZ_PVP=false
PZ_WELCOME_MESSAGE=Bienvenido a Zroyecto Pombie. Escribe /help para ver los comandos.

# Mods. Se rellenan en la fase 3, de uno en uno y probando en staging.
# WorkshopItems = IDs numericos del Workshop; Mods = IDs internos de los mods.
PZ_WORKSHOP_ITEMS=
PZ_MODS=
PZ_MAP=Muldraugh, KY

# --- Recursos --------------------------------------------------------------
# 8 GB va sobrado para 2-6 jugadores. Build 42 movio el inventario al lado
# servidor, asi que consume bastante mas que Build 41.
PZ_MEMORY=8g
PZ_MEMORY_MIN=2g

# --- Puertos internos (no los toques sin motivo) ---------------------------
PZ_PORT=16261
PZ_UDP_PORT=16262

# --- Puertos publicados en el host -----------------------------------------
# En que interfaz del host escucha el juego.
#
#   0.0.0.0            todas: LAN, WiFi y, si hay reenvio en el router, Internet.
#   <IP de Tailscale>  solo dentro del tailnet. Es lo que convierte las ACL de
#                      Tailscale en el unico control de acceso: sin esto el
#                      servidor sigue accesible desde la red local, donde
#                      ninguna ACL de Tailscale interviene.
#
# La IP de Tailscale de esta maquina:  tailscale ip -4
HOST_BIND_IP=0.0.0.0

# Estos son los que se abren en el router SI se expone por Internet. Ambos UDP.
# Exponiendo por Tailscale no hay que abrir nada en el router.
HOST_GAME_PORT=16261
HOST_GAME_PORT_2=16262
HOST_RCON_PORT=27015

STAGING_GAME_PORT=16361
STAGING_GAME_PORT_2=16362
STAGING_RCON_PORT=27115

# --- Mundo vanilla ----------------------------------------------------------
# Mundo aparte con el mismo mapa y ajustes que produccion pero lista de mods
# propia y corta. Nacio sin mods para comparar; hoy lleva los reversibles
# (criterio en docs/MODS-LISTA.md seccion 0). Perfil `vanilla`: no arranca solo.
VANILLA_SERVER_NAME=pombie-vanilla
VANILLA_GAME_PORT=16461
VANILLA_GAME_PORT_2=16462
VANILLA_RCON_PORT=27215
VANILLA_MEMORY=3g

# Lista de mods del mundo vanilla. Vacias = el default del compose (7 mods de
# interfaz pura). Mismo formato que PZ_WORKSHOP_ITEMS / PZ_MODS; el orden ES
# el orden de carga. Solo mods reversibles: los de via unica pasan antes por
# staging (docs/OPERACIONES.md).
VANILLA_WORKSHOP_ITEMS=
VANILLA_MODS=

# --- Control de actualizaciones -------------------------------------------
# false = el arranque NO comprueba actualizaciones de Steam.
#
# Esto es deliberado y es el nucleo de la proteccion contra guardados
# corruptos. Con esto en true, cualquier reinicio rutinario un dia que Steam
# haya publicado un parche cambiaria el motor por debajo de un mundo vivo.
# Para actualizar: ./scripts/update-server.sh
UPDATE_ON_START=false

# Autoriza abrir el mundo con una version del juego distinta a la que se venia
# usando. Dejalo SIEMPRE en false; update-server.sh lo activa por ti cuando
# corresponde y tras hacer backup.
ALLOW_BUILD_CHANGE=false

# --- Backups ---------------------------------------------------------------
BACKUP_ON_START=true
BACKUP_INTERVAL_HOURS=6
# Cuantos backups rotables conservar, POR ETIQUETA y POR INSTANCIA: con 20 son
# 20 periodic y 20 prestart, no 20 en total. Los demas (manual, stage,
# pre-update, pre-restore) no se borran nunca: son justo los que quieres cuando
# algo va mal. Ver docs/OPERACIONES.md, "Lo que se acumula sin limite".
BACKUP_KEEP=20

# Minutos que deben pasar para que un arranque vuelva a hacer su backup
# 'prestart'. Evita que un bucle de reinicios haga 20 copias del estado roto y
# expulse por rotacion las 20 buenas. A 0 se desactiva la proteccion.
BACKUP_PRESTART_MIN_GAP_MINUTES=60

# Segundos que espera un backup si ya hay otro en marcha antes de rendirse.
# Solo un backup a la vez: dos compresiones del mismo mundo se pelean por la
# CPU y sus rotaciones se pisan.
BACKUP_LOCK_WAIT=600

# --- Apagado ---------------------------------------------------------------
# Aviso a los jugadores antes de guardar y cerrar.
SHUTDOWN_WARNING_SECONDS=15
# Espera tras el `save` para que termine de escribir a disco antes del `quit`.
SAVE_SETTLE_SECONDS=10
# Plazo para que el JVM muera solo antes de escalar a SIGTERM.
# Tiene que ser MENOR que el stop_grace_period del compose (180s).
SHUTDOWN_TIMEOUT=150

# --- Permisos de ficheros --------------------------------------------------
# En Windows da igual. Importa al migrar a Linux: pon aqui el UID/GID del
# usuario que vaya a ser dueno de los datos en la maquina destino.
PUID=1000
PGID=1000

TZ=Europe/Madrid

# --- Mods solo para staging -------------------------------------------------
# Lista de mods a probar en el entorno de ensayo. Si estan vacias, staging
# replica exactamente los mods de produccion (que es lo que quieres cuando
# ensayas otra cosa, como una actualizacion del juego).
# Para probar un mod nuevo: se pone aqui, se levanta staging, se comprueba, y
# solo entonces se pasa a PZ_WORKSHOP_ITEMS / PZ_MODS.
STAGING_WORKSHOP_ITEMS=
STAGING_MODS=
